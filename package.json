{
  "name": "desarrollo-aplicaciones-front",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npx expo start -c",
    "dev:android": "npx expo start -c --android",
    "dev:ios": "npx expo start -c --ios",
    "dev:web": "npx expo start -c --web",
    "android": "expo start --android",
    "build:dev:android": "eas build -p android --profile preview",
    "build:prod:android": "eas build -p android --profile production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom=\"src/utils/**/*.ts\" --collectCoverageFrom=\"!src/utils/qr.ts\" --collectCoverageFrom=\"!src/utils/image.ts\""
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.17.0",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "ngrok": "^5.0.0-beta.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.2",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
